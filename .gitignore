local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# runtime data & environment (T29 hygiene — keep the repo code-only)
/db/*
# T50: the SQLite file IS the deployment dataset — tracked so Vercel-style
# serverless builds carry every market table (flows, indices, news archive,
# AI signal sets, agent records). Everything else in /db/ stays local.
!/db/custom.db
/.env
/dev.log
/tool-results/
/agent-ctx/

# local Vercel simulation output (T50)
/.vercel-test/
.vercel-sim/
esthmr-session.txt
esthmr-explore/cookies.txt
esthmr-explore/temp_token.txt
# T61: all local secrets stay out of the public repo (was: vapid.json only)
/server-secrets/
# T61: the two daily-refresh workflows cannot be pushed with a repo-scoped
# token (GitHub blocks .github/workflows writes without the workflow scope) —
# they live on disk for the eventual web-UI landing (docs/WORKFLOWS.md §native)
# and the sandbox refresh-daemon (scripts/refresh-daemon.mjs) covers the job.
.github/workflows/
# T61: refresh-daemon runtime state (the log is covered by *.log)
/scripts/refresh-state.json
