{
  "name": "EGX Desk — بيانات البورصة المصرية",
  "short_name": "EGX Desk",
  "description": "Live Egyptian Exchange data: quotes, insider log, investor flows, statements, dividends, calendar, signals and tools — Arabic-first, bilingual. GCC markets and paper trading included.",
  "lang": "ar",
  "dir": "rtl",
  "id": "/?view=home",
  "start_url": "/?view=home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "categories": ["finance", "business", "productivity", "news"],
  "background_color": "#2c2c2e",
  "theme_color": "#2c2c2e",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
