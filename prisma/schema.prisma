generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

/* Schema note (Task 20 cleanup): the 12 seed-era models from the original
 * esthmr-clone build (Sector, Company, PricePoint, FinancialPeriod,
 * Disclosure, NewsItem, IndexQuote, InvestorFlow, User, OtpCode, Session,
 * WatchItem) were dropped — the app has run entirely on the live public data
 * layer (src/lib/market.ts & friends) since Task 4, auth/watchlist are
 * device-local (localStorage + egx-device-id), and nothing in src/ referenced
 * them. What remains is what the running app actually persists. */

// ── Investor-category flows (daily snapshots, real EGX data) ──

/** One trading day's aggregate investor-flow figures (EGP millions). */
model FlowDay {
  date       String    @id // YYYY-MM-DD (trading session)
  scope      String    @default("Equities only, OPR included, OTC not included")
  totalBuy   Float // EGP mn
  totalSell  Float // EGP mn
  turnover   Float // 2-way value traded, EGP mn
  retailPct  Float?
  instPct    Float?
  capturedAt DateTime  @default(now())
  cats       FlowCat[]
}

/** Buy/sell/net per investor category for a FlowDay. */
model FlowCat {
  id         String  @id @default(cuid())
  date       String
  day        FlowDay @relation(fields: [date], references: [date], onDelete: Cascade)
  key        String // EGY_RETAIL | EGY_INST | ARAB_RETAIL | ARAB_INST | FOR_RETAIL | FOR_INST
  buy        Float // EGP mn
  sell       Float // EGP mn
  net        Float // EGP mn
  turnover   Float // EGP mn
  tradingPct Float // share of total trading value

  @@unique([date, key])
}

/** Real daily closes for the EGX indices (backfilled from EGXBot session reports). */
model IndexDay {
  date       String   @id // YYYY-MM-DD trading session
  egx30      Float?
  egx70      Float?
  egx100     Float?
  source     String   @default("egxbot")
  capturedAt DateTime @default(now())
}

/** Archived news posts (backfilled from the publishers' WordPress REST APIs,
 *  kept fresh from their RSS feeds) — newest first in the news view. */
model NewsPost {
  id          String   @id @default(cuid())
  link        String   @unique
  title       String
  snippet     String?
  source      String
  categories  String   @default("") // "،"-joined display names
  publishedAt DateTime
  firstSeenAt DateTime @default(now())

  @@index([publishedAt])
}

/** Daily market participation by nationality (from EGXBot session reports). */
model ParticipationDay {
  date          String   @id // YYYY-MM-DD
  egyptiansPct  Float?
  arabsPct      Float?
  foreignersPct Float?
  totalValueEgpMn Float? // one-way value traded, EGP mn
  egx30Close    Float?
  egx30ChangePct Float?
  source        String   @default("egxbot")
  capturedAt    DateTime @default(now())
}

/** Daily market breadth (how many listed shares rose / fell / held) —
 *  imported from the published exchange record. */
model BreadthDay {
  date       String   @id // YYYY-MM-DD trading session
  up         Int?
  down       Int?
  flat       Int?
  counted    Int?
  source     String   @default("esthmr")
  capturedAt DateTime @default(now())
}

// ── Self-collected intraday ticks (T26: 1D/1W chart timeframes) ──

/** One quote sample for one ticker, taken while the EGX session is open.
 *  No free source serves true EGX intraday candles (Yahoo stamps ONE bar per
 *  day), so the desk samples the live TradingView universe quote itself
 *  every ~5 minutes and stores the ticks here — honest, delayed ~15 min,
 *  accumulating session by session. `minuteKey` is the Cairo-time
 *  "YYYY-MM-DD HH:MM" bucket used for dedupe; `volume` is the cumulative
 *  session volume at sample time (diffed into per-bar volume on read). */
model IntradayTick {
  id        Int      @id @default(autoincrement())
  ticker    String
  minuteKey String // Cairo "YYYY-MM-DD HH:MM"
  ts        DateTime @default(now())
  close     Float
  volume    Float? // cumulative session volume at sample time
  changePct Float?

  @@unique([ticker, minuteKey])
  @@index([ticker])
  @@index([ts])
}

// ── Web-push devices (G1 mobile: iOS/Android installed-PWA notifications) ──

/** One installed app instance that opted into phone notifications.
 *  `alertsJson` mirrors the device's localStorage alert list (synced on every
 *  change); `notifiedJson` holds alert ids the SERVER already pushed, so each
 *  alert notifies exactly once even when the app is closed. */
model PushDevice {
  id             String    @id @default(cuid())
  deviceId       String    @unique // client-generated uuid (egx-device-id)
  endpoint       String    @unique // push-service subscription endpoint URL
  p256dh         String // subscription key
  auth           String // subscription key
  alertsJson     String    @default("[]")
  notifiedJson   String    @default("[]")
  /// T44 — user opted into LIVE SIGNAL notifications (new picks, plan
  /// outcomes, self-validation) on top of the personal price alerts
  signalsOptIn   Boolean   @default(false)
  /// newest SignalEvent.createdAt already pushed to this device — the push
  /// loop only sends strictly newer events, so each fires exactly once
  signalsNotifiedAt DateTime?
  lang           String    @default("ar")
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastNotifiedAt DateTime?
}

// ── AI agent chat history (server-side, per device) ──

/** One saved agent conversation. `messagesJson` holds the full chat (user +
 *  assistant messages with tool-step metadata) so the device can resume any
 *  past conversation; rows are keyed by the client uuid (egx-device-id), the
 *  same identity PushDevice uses. Saved automatically after every exchange. */
model AgentChat {
  id           String   @id // client-generated uuid (stable across saves)
  deviceId     String
  title        String   @default("") // first user message, truncated
  messagesJson String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([deviceId, updatedAt])
}

/// One row per /api/agent request (Task 19 usage metering + the persisted
/// per-user hourly rate limit). route is kept for future non-agent meters.
model UsageEvent {
  id          String   @id @default(uuid())
  ip          String
  deviceId    String?
  route       String   @default("agent")
  llmCalls    Int      @default(0)
  toolCalls   Int      @default(0)
  webSearches Int      @default(0)
  ok          Boolean  @default(true)
  ms          Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([deviceId, createdAt])
}

// ── AI Signals (Task 20: the shared-compute signals section) ──

/** One AI Signals generation — the JSON payload produced by a single LLM
 *  synthesis call over the deterministic strategy evidence (src/lib/strategy.ts
 *  + scanSignals). ONE call serves EVERY user (computed once, cached here,
 *  refreshed on a cooldown) — that shared-compute pattern is what keeps the
 *  section public and totally free. Only the newest sets are kept. */
model AiSignalSet {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  model        String   @default("GLM")
  strategyRev  String   @default("egx-trend-v1")
  llmMs        Int      @default(0)
  data         String // validated JSON: marketBias + picks[] + notes
  backtestRev  String   @default("") // strategyRev the shipped backtest.json ran

  @@index([createdAt])
}

// ── Market Desk Reports (Task 22: hourly while the market is open + the
//    final end-of-day report) ──

/** One desk report — the shared-compute "what could surge next" briefing.
 *  `kind` is "hourly" (one per Cairo trading hour while the session is open)
 *  or "eod" (the final report published after the close). `session` is the
 *  YYYY-MM-DD trading session the report belongs to; `hourLabel` is the
 *  Cairo floor-hour ("10:00".."13:00") for hourly reports and "" for eod.
 *  ONE LLM call + a couple of shared web searches produce a report that is
 *  served to EVERY visitor from cache — same free-public economics as
 *  AiSignalSet. Rows are pruned (newest kept). */
model MarketReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String // "hourly" | "eod"
  session   String // YYYY-MM-DD trading session (Cairo)
  hourLabel String   @default("") // floor hour "HH:00" for hourly, "" for eod
  model     String   @default("GLM")
  llmMs     Int      @default(0)
  webSearches Int    @default(0)
  data      String // validated JSON: marketBias + movers[] + webNotes + sources

  @@index([session, kind])
  @@index([createdAt])
}

// ── Live signal events (Task 44: per-signal live notifications) ──

/** One live event in the signals stream — what the LIVE FEED shows and what
 *  opted-in devices receive as push notifications. Emitted when a NEW signal
 *  set is published (new picks + the market-bias read), when the track
 *  record resolves a published episode (target / stop / expiry), when the
 *  self-validation check compares the live record against the backtest
 *  baseline (ASTP-style review, at most once per Cairo day), and when the
 *  autonomous agent (T45) publishes one of its weekday runs.
 *
 *  `setRef` links pick/bias/agent events to the AiSignalSet id they came from;
 *  `episodeKey` (ticker + issuedAt ms) links outcome events to the exact
 *  tracked episode — both make emission idempotent (never double-notify). */
model SignalEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// new-pick | bias | outcome | self-check | agent
  kind        String
  ticker      String?  // null for market-level events (bias / self-check / agent)
  stance      String?  // long | avoid (pick events)
  setRef      String?  // AiSignalSet id for pick/bias/agent events
  episodeKey  String?  // `${ticker}:${issuedAtMs}` for outcome events
  titleAr     String
  titleEn     String
  bodyAr      String
  bodyEn      String
  /// optional machine number (e.g. return % at resolution, probUp)
  score       Float?

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([episodeKey])
}

// ── T45: the AUTONOMOUS self-learning signal agent (hermes) ──

/** One autonomous agent run — the weekday schedule (pre-open / midday /
 *  post-close, Cairo Sun–Thu) or a manual trigger. `outputJson` carries the
 *  FULL agent payload: the validated signal set (same AiSetPayload shape the
 *  shared pipeline serves, so it flows into the track record + live events
 *  unchanged) PLUS the agent extras — the vision reads, the journal
 *  reflection, the learning state snapshot, and the skills that ran.
 *  `status` is "ok" or "failed"; a failed run stores the honest error and
 *  NEVER fabricates output. */
model AgentRun {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  /// pre-open | midday | post-close | manual
  kind         String
  /// the Cairo YYYY-MM-DD the run belongs to (dedupe key with kind)
  session      String
  model        String   @default("glm-4.7-flash")
  visionModel  String   @default("glm-4.6v-flash")
  status       String   @default("ok")
  llmMs        Int      @default(0)
  visionMs     Int      @default(0)
  /// the AiSignalSet this run persisted (null on failure)
  setRef       String?
  outputJson   String? // full agent payload (set + agent extras)
  error        String?

  @@index([session, kind])
  @@index([startedAt])
}

/** One memory entry — the agent's LEARNING JOURNAL. Written when the
 *  learning layer moves a strategy weight (kind "weight-change", with the
 *  before/after numbers in dataJson) and once per run for the LLM's own
 *  reflection (kind "reflection" — what it saw, what it concluded, what it
 *  will watch next). Milestone entries (kind "milestone") mark first runs /
 *  record thresholds. This is the hermes-agent-inspired long-term memory:
 *  each run reads the latest lessons, so the agent starts every session
 *  already knowing what its own record taught it. */
model AgentLesson {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  runId     String?
  /// reflection | weight-change | milestone
  kind      String
  textAr    String
  textEn    String
  dataJson  String?

  @@index([createdAt])
  @@index([kind, createdAt])
}

/** T46 — SUPERMEMORY: the agent's UNLIMITED semantic memory (supermemory /
 *  supermemory-mcp inspired, local-first). Every run stores what happened
 *  (reflections, picks, market reads, vision verdicts, lessons); every later
 *  run RECALLS the most semantically-relevant entries via a hashed-embedding
 *  cosine search, so context survives DB resets, stays connected across
 *  weeks, and grows without limit. Rows are plain data: text + tags + a
 *  compact embedding vector (JSON numbers) + optional cloud-sync metadata.
 *  When a SUPERMEMORY_API_KEY is configured the same entries are mirrored to
 *  the Supermemory cloud (honest best-effort — the local engine always
 *  serves recall; the cloud is a backup, never a dependency). */
model AgentMemory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// reflection | pick | bias | vision | lesson | milestone
  kind      String
  /// the memory's working text (English — the recall engine's language)
  text      String
  /// optional Arabic twin for UI display
  textAr    String?
  /// short tags (tickers, run kind, bias direction) — JSON string[]
  tagsJson  String?
  /// the hashed bag-of-words embedding — JSON number[] (dim 384, L2-normalized)
  embJson   String
  /// the AgentRun that created this memory, when applicable
  sourceRun String?
  /// small structured extras (conviction, stance, verdict, multiplier…)
  metaJson  String?
  /// when mirrored to the Supermemory cloud: the remote document id
  cloudId   String?

  @@index([kind, createdAt])
  @@index([createdAt])
}
