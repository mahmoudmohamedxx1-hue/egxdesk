# EGX Desk — environment template (copy to .env and fill in).
# NOTE: sandbox resets regenerate .env with only DATABASE_URL — re-add the
# keys below (values live in the owner's Supabase dashboard / notes).

# Prisma local db
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Supabase project (Settings → API): URL + publishable + service-role keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# T48 security layer: the site owner + one-time bootstrap code (rotate freely)
ADMIN_EMAIL=
ADMIN_SETUP_CODE=
# random 32-byte hex — signs the 90-day admin device-trust cookie
AUTH_TRUST_SECRET=
# random 32-byte hex — signs the 15-min HMAC sign-in challenges
AUTH_CHALLENGE_SECRET=

# Z.AI GLM key for the autonomous signal agent (server-side only)
ZAI_API_KEY=

# optional: supermemory cloud mirror (leave empty = local-only)
SUPERMEMORY_API_KEY=
